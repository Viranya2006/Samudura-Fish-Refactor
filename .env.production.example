# Production settings for samudura.duckdns.org (fish POS).
# On the server this file lives at ~/domains/samudura.duckdns.org/shared/.env
# Fill in the blanks there (DirectAdmin File Manager or Terminal). Never commit real values.

APP_NAME="Samudura Fish POS"
APP_ENV=production
# Make one in the server Terminal:
#   /usr/local/bin/php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_DEBUG=false
APP_URL=https://samudura.duckdns.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=samudura_samudura_fish
DB_USERNAME=samudura_samudura_fish
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
