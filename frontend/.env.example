# Laravel API is same-origin in production; in dev Vite proxies /api to http://127.0.0.1:8000

# Optional: local print + customer display service (default base http://localhost:5555)
# If set, use the same origin as in printReceipt, e.g. http://localhost:5555/print
# VITE_PRINT_SERVICE_URL=http://localhost:5555/print
# USB / Windows printer via Chrome print dialog (keeps PLU auto-sync on localhost):
# VITE_USE_BROWSER_PRINT=true
# Optional: Web Serial baud for pole (default 2400) when using browser USB on HTTPS
# VITE_DISPLAY_SERIAL_BAUD=2400
